%% PayLink - Use Case Diagram (Phase 1)
%% Owner: Person 3 (Architecture and Data Design)
%% Each use case has the same ID and name as its user story in requirements.md (US-01 .. US-28).
%% Solid arrow = actor takes part in the use case. Dotted arrow = <<include>> / <<extend>>.
flowchart LR
  classDef actor fill:#E8EEF7,stroke:#1F3864,stroke-width:2px,color:#1F3864,font-weight:bold
  classDef uc fill:#FFFFFF,stroke:#2E75B6,stroke-width:1.5px,color:#000000

  %% ---------- Primary actors ----------
  Customer["«actor»<br/>Customer"]:::actor
  Agent["«actor»<br/>Agent"]:::actor
  Admin["«actor»<br/>Administrator"]:::actor
  Support["«actor»<br/>Customer Support<br/>Employee"]:::actor

  subgraph PayLink["PayLink Backend"]
    US01(["US-01 Customer Registration"]):::uc
    US02(["US-02 Upgrade Customer<br/>Verification Level"]):::uc
    US03(["US-03 View Wallet Balance<br/>and Transaction History"]):::uc
    US04(["US-04 Top Up Wallet"]):::uc
    US05(["US-05 Record Every Wallet<br/>Balance Change in the Ledger"]):::uc
    US06(["US-06 Manage Billers<br/>and Services"]):::uc
    US07(["US-07 View Available Billers<br/>and Required Input Fields"]):::uc
    US08(["US-08 Inquire About a Bill<br/>and View Total Amount"]):::uc
    US09(["US-09 Pay a Bill<br/>Using the Wallet"]):::uc
    US10(["US-10 Prevent Duplicate Payments<br/>Using Idempotency"]):::uc
    US11(["US-11 Enforce the<br/>Payment Lifecycle"]):::uc
    US12(["US-12 Hold and Release<br/>Wallet Funds"]):::uc
    US13(["US-13 Handle Payment Timeouts<br/>and Unknown Status"]):::uc
    US14(["US-14 Process TopUpNet<br/>Asynchronous Callbacks"]):::uc
    US15(["US-15 Integrate at Least<br/>Three Different Billers"]):::uc
    US16(["US-16 Calculate the<br/>Service Fee"]):::uc
    US17(["US-17 Agent Pays on Behalf of a<br/>Customer and Earns Commission"]):::uc
    US18(["US-18 Reject Payments<br/>Above the Limits"]):::uc
    US19(["US-19 Block Accounts that Pay<br/>Too Fast (Velocity Rule)"]):::uc
    US20(["US-20 Search a Payment<br/>and View Its History"]):::uc
    US21(["US-21 Block and Unblock<br/>an Account"]):::uc
    US22(["US-22 Notify the Customer<br/>of the Payment Result"]):::uc
    US23(["US-23 Retry Failed<br/>Notifications"]):::uc
    US24(["US-24 Edit Fee and Limit Values<br/>Without Redeploying"]):::uc
    US25(["US-25 Write an Audit Log for Money<br/>Movements and Admin Actions"]):::uc
    US26(["US-26 Produce the Daily<br/>Reconciliation Report"]):::uc
    US27(["US-27 Request and Approve a Refund<br/>of a Completed Payment"]):::uc
    US28(["US-28 View Daily Totals"]):::uc
  end

