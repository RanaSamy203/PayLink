@startuml er-diagram
' PayLink - ER Diagram (Phase 1) - PlantUML version
' Owner: Person 3 (Architecture and Data Design)
' Generated from er-diagram.mmd; both files describe the same 29 tables.
' Money columns are DECIMAL(14,2); rates DECIMAL(6,4). No FLOAT anywhere.
' (CHECK: A, B) = a CHECK constraint that allows only those values.
' Times are stored with time zone; the business day is Africa/Cairo.

hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor #F7F9FC
  BorderColor #2B5F9E
}

' ===================== Accounts and Wallet =====================
entity wallets {
  * id : UUID <<PK>>
  --
  type : VARCHAR  (CHECK: CUSTOMER, AGENT, PAYLINK_FEES, BILLER_PAYABLE)
  currency : CHAR  (EGP)
  created_at : TIMESTAMP
}

entity customers {
  * id : UUID <<PK>>
  --
  wallet_id : UUID <<FK>> <<UK>>
  full_name : VARCHAR
  phone : VARCHAR <<UK>>  (login id in the customer app)
  email : VARCHAR
  password_hash : VARCHAR
  verification_level : VARCHAR  (CHECK: BASIC, VERIFIED)
  status : VARCHAR  (CHECK: ACTIVE, BLOCKED)
  blocked_until : TIMESTAMP  (null = not temporarily blocked)
  created_at : TIMESTAMP
}

entity agents {
  * id : UUID <<PK>>
  --
  wallet_id : UUID <<FK>> <<UK>>
  full_name : VARCHAR
  phone : VARCHAR <<UK>>  (unique among agents; may equal a customer phone)
  password_hash : VARCHAR
  terminal_id : VARCHAR <<UK>>  (login id at the terminal)
  shop_name : VARCHAR
  status : VARCHAR  (CHECK: ACTIVE, BLOCKED)
  blocked_until : TIMESTAMP
  created_at : TIMESTAMP
}

entity staff_users {
  * id : UUID <<PK>>
  --
  full_name : VARCHAR
  email : VARCHAR <<UK>>  (login id in the staff portal)
  password_hash : VARCHAR
  role : VARCHAR  (CHECK: ADMINISTRATOR, SUPPORT)
  status : VARCHAR  (CHECK: ACTIVE, BLOCKED)
  created_at : TIMESTAMP
}

entity verification_requests {
  * id : UUID <<PK>>
  --
  customer_id : UUID <<FK>>
  decided_by : UUID <<FK>>  (staff_users.id)
  document_ref : VARCHAR
  status : VARCHAR  (CHECK: PENDING, APPROVED, REJECTED)
  submitted_at : TIMESTAMP
  decided_at : TIMESTAMP
}

entity ledger_entries {
  * id : UUID <<PK>>
  --
  wallet_id : UUID <<FK>>
  payment_id : UUID <<FK>>  (nullable)
  top_up_id : UUID <<FK>>  (nullable)
  amount : DECIMAL(14,2)  (signed: + credit, - debit)
  bucket : VARCHAR  (CHECK: AVAILABLE, HELD)
  entry_type : VARCHAR  (CHECK: TOP_UP, HOLD, HOLD_RELEASE, CHARGE, FEE_INCOME, COMMISSION, COMMISSION_REVERSAL, REFUND)
  description : VARCHAR
  created_at : TIMESTAMP
}

entity holds {
  * id : UUID <<PK>>
  --
  wallet_id : UUID <<FK>>
  payment_id : UUID <<FK>> <<UK>>
  amount : DECIMAL(14,2)
  status : VARCHAR  (CHECK: ACTIVE, CAPTURED, RELEASED)
  created_at : TIMESTAMP
  released_at : TIMESTAMP
}

entity top_ups {
  * id : UUID <<PK>>
  --
  wallet_id : UUID <<FK>>
  agent_id : UUID <<FK>>  (nullable, set for AGENT_CASH)
  amount : DECIMAL(14,2)
  method : VARCHAR  (CHECK: CARD, AGENT_CASH)
  status : VARCHAR  (CHECK: PENDING, SUCCEEDED, DECLINED)
  failure_reason : VARCHAR  (set when DECLINED)
  idempotency_key : VARCHAR <<UK>>
  created_at : TIMESTAMP
}

' ===================== Biller Catalog =====================
entity billers {
  * id : UUID <<PK>>
  --
  code : VARCHAR <<UK>>
  name : VARCHAR
  protocol : VARCHAR  (CHECK: REST_JSON, SOAP_XML, ASYNC_REST, BATCH_CSV)
  base_url : VARCHAR
  timeout_seconds : INT  (default 10)
  active : BOOLEAN
}

entity biller_services {
  * id : UUID <<PK>>
  --
  biller_id : UUID <<FK>>
  fee_rule_id : UUID <<FK>>
  name : VARCHAR
  category : VARCHAR  (CHECK: ELECTRICITY, WATER, MOBILE, INTERNET)
  min_amount : DECIMAL(14,2)
  max_amount : DECIMAL(14,2)
  supports_inquiry : BOOLEAN
  active : BOOLEAN
}

entity service_input_fields {
  * id : UUID <<PK>>
  --
  service_id : UUID <<FK>>
  name : VARCHAR
  label : VARCHAR
  validation_regex : VARCHAR
  required : BOOLEAN
}

' ===================== Fees and Commissions =====================
entity fee_rules {
  * id : UUID <<PK>>
  --
  rule_type : VARCHAR  (CHECK: FIXED, PERCENTAGE, TIERED)
  fixed_fee : DECIMAL(14,2)
  rate : DECIMAL(6,4)
  minimum_fee : DECIMAL(14,2)
}

entity fee_tiers {
  * id : UUID <<PK>>
  --
  fee_rule_id : UUID <<FK>>
  up_to_amount : DECIMAL(14,2)  (inclusive; null = no upper bound)
  fee : DECIMAL(14,2)
}

entity promotions {
  * id : UUID <<PK>>
  --
  biller_id : UUID <<FK>>
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
}

entity commissions {
  * id : UUID <<PK>>
  --
  payment_id : UUID <<FK>> <<UK>>
  agent_id : UUID <<FK>>
  amount : DECIMAL(14,2)
  rate : DECIMAL(6,4)  (default 0.40)
  created_at : TIMESTAMP
  reversed_at : TIMESTAMP
}

' ===================== Payment Processing =====================
entity bill_inquiries {
  * id : UUID <<PK>>
  --
  customer_id : UUID <<FK>>
  service_id : UUID <<FK>>
  bill_account_ref : VARCHAR
  amount_due : DECIMAL(14,2)
  fee : DECIMAL(14,2)
  total : DECIMAL(14,2)
  expires_at : TIMESTAMP
  created_at : TIMESTAMP
}

entity payments {
  * id : UUID <<PK>>
  --
  reference : VARCHAR <<UK>>
  customer_id : UUID <<FK>>
  agent_id : UUID <<FK>>  (nullable)
  service_id : UUID <<FK>>
  inquiry_id : UUID <<FK>>  (nullable)
  idempotency_key : VARCHAR  (UK with customer_id)
  request_hash : VARCHAR
  bill_account_ref : VARCHAR
  amount : DECIMAL(14,2)
  fee : DECIMAL(14,2)
  total : DECIMAL(14,2)
  status : VARCHAR  (CHECK: INITIATED, FUNDS_HELD, SENT_TO_BILLER, COMPLETED, FAILED, UNKNOWN, REJECTED, REFUNDED)
  biller_reference : VARCHAR
  failure_reason : VARCHAR
  retry_count : INT
  next_retry_at : TIMESTAMP
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity payment_status_changes {
  * id : UUID <<PK>>
  --
  payment_id : UUID <<FK>>
  from_status : VARCHAR  (CHECK: same 8 values, null for the first row)
  to_status : VARCHAR  (CHECK: same 8 values as payments.status)
  event : VARCHAR
  reason : VARCHAR
  changed_at : TIMESTAMP
}

entity biller_calls {
  * id : UUID <<PK>>
  --
  payment_id : UUID <<FK>>  (nullable for inquiries)
  biller_id : UUID <<FK>>
  call_type : VARCHAR  (CHECK: INQUIRY, PAYMENT, STATUS_QUERY)
  request_payload : TEXT
  response_payload : TEXT
  outcome : VARCHAR  (CHECK: SUCCESS, REFUSED, TIMEOUT, ERROR)
  duration_ms : INT
  called_at : TIMESTAMP
}

entity biller_callbacks {
  * id : UUID <<PK>>
  --
  payment_id : UUID <<FK>>  (null if unmatched)
  biller_id : UUID <<FK>>
  biller_reference : VARCHAR
  result : VARCHAR  (CHECK: success, failed)
  raw_payload : TEXT
  duplicate : BOOLEAN
  received_at : TIMESTAMP
}

entity refund_requests {
  * id : UUID <<PK>>
  --
  payment_id : UUID <<FK>> <<UK>>
  requested_by : UUID <<FK>>  (customers.id)
  decided_by : UUID <<FK>>  (staff_users.id)
  reason : VARCHAR
  refund_amount : DECIMAL(14,2)
  status : VARCHAR  (CHECK: PENDING, APPROVED, REJECTED)
  requested_at : TIMESTAMP
  decided_at : TIMESTAMP
}

' ===================== Notifications =====================
entity message_templates {
  * code : VARCHAR <<PK>>
  --
  channel : VARCHAR  (CHECK: SMS, EMAIL, PUSH)
  event : VARCHAR  (CHECK: COMPLETED, FAILED, PROCESSING)
  text : TEXT
}

entity notifications {
  * id : UUID <<PK>>
  --
  payment_id : UUID <<FK>>  (nullable)
  template_code : VARCHAR <<FK>>
  channel : VARCHAR  (CHECK: SMS, EMAIL, PUSH)
  event : VARCHAR  (CHECK: COMPLETED, FAILED, PROCESSING)
  recipient : VARCHAR
  body : TEXT
  status : VARCHAR  (CHECK: PENDING, DELIVERED, UNDELIVERED)
  attempts : INT  (max 4: 1 attempt + 3 retries)
  next_retry_at : TIMESTAMP
  created_at : TIMESTAMP
}

' ===================== Reconciliation =====================
entity settlement_files {
  * id : UUID <<PK>>
  --
  biller_id : UUID <<FK>>
  settlement_date : DATE  (UK with biller_id)
  file_name : VARCHAR
  received_at : TIMESTAMP
}

entity settlement_records {
  * id : UUID <<PK>>
  --
  settlement_file_id : UUID <<FK>>
  payment_reference : VARCHAR
  amount : DECIMAL(14,2)
  biller_status : VARCHAR
  transaction_date : DATE
}

entity reconciliation_reports {
  * id : UUID <<PK>>
  --
  settlement_file_id : UUID <<FK>> <<UK>>
  report_date : DATE
  status : VARCHAR  (CHECK: COMPLETE, INCOMPLETE)
  matched_count : INT
  difference_count : INT
  created_at : TIMESTAMP
}

entity reconciliation_differences {
  * id : UUID <<PK>>
  --
  report_id : UUID <<FK>>
  payment_id : UUID <<FK>>  (nullable)
  settlement_record_id : UUID <<FK>>  (nullable)
  type : VARCHAR  (CHECK: MISSING_AT_PAYLINK, MISSING_AT_BILLER, AMOUNT_MISMATCH, STATUS_MISMATCH)
  details : VARCHAR
  resolved : BOOLEAN
}

' ===================== Shared =====================
entity system_settings {
  * key : VARCHAR <<PK>>
  --
  value : VARCHAR
  updated_by : UUID <<FK>>  (staff_users.id)
  updated_at : TIMESTAMP
}

entity audit_logs {
  * id : UUID <<PK>>
  --
  actor_type : VARCHAR  (CHECK: CUSTOMER, AGENT, STAFF, SYSTEM)
  actor_id : UUID
  action : VARCHAR
  entity_type : VARCHAR
  entity_id : UUID
  amount : DECIMAL(14,2)  (nullable)
  details : VARCHAR  (what changed)
  reason : VARCHAR  (why)
  created_at : TIMESTAMP
}

' ===================== Relationships =====================
customers ||--|| wallets : owns
agents ||--|| wallets : owns
customers ||--o{ verification_requests : submits
staff_users |o--o{ verification_requests : decides
wallets ||--o{ ledger_entries : records
wallets ||--o{ holds : reserves
wallets ||--o{ top_ups : receives
agents |o--o{ top_ups : collects cash for
top_ups |o--o{ ledger_entries : creates
payments |o--o{ ledger_entries : creates

billers ||--|{ biller_services : offers
biller_services ||--|{ service_input_fields : requires
fee_rules ||--o{ biller_services : prices
fee_rules ||--o{ fee_tiers : has
billers ||--o{ promotions : has

customers ||--o{ bill_inquiries : runs
biller_services ||--o{ bill_inquiries : for
customers ||--o{ payments : pays
agents |o--o{ payments : made at
biller_services ||--o{ payments : for
bill_inquiries |o--o{ payments : based on
payments ||--o| holds : holds funds with
payments ||--|{ payment_status_changes : history
payments |o--o{ biller_calls : sends
billers ||--o{ biller_calls : receives
payments |o--o{ biller_callbacks : receives
billers ||--o{ biller_callbacks : sends
payments ||--o| commissions : earns
agents ||--o{ commissions : credited to
payments ||--o| refund_requests : refunded by
customers ||--o{ refund_requests : requests
staff_users |o--o{ refund_requests : approves

payments |o--o{ notifications : triggers
message_templates ||--o{ notifications : uses

billers ||--o{ settlement_files : sends
settlement_files ||--o{ settlement_records : contains
settlement_files ||--|| reconciliation_reports : produces
reconciliation_reports ||--o{ reconciliation_differences : lists
payments |o--o{ reconciliation_differences : flagged in
settlement_records |o--o{ reconciliation_differences : flagged in

staff_users |o--o{ system_settings : edits

@enduml
